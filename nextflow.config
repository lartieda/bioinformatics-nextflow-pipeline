nextflow.enable.dsl = 2

plugins {
    id 'nf-amazon'
}

docker.enabled = true

params {
    input = 'data/expression.csv'
    outdir = 'results'
    preprocess_script = 'scripts/preprocess.py'
    analyze_script = 'scripts/analyze.py'
}

profiles {
    /*
     * Default local execution:
     * uses the tracked example input and writes results locally.
     */
    local {
        docker.enabled = true
    }

    /*
     * Cloud-storage execution:
     * keeps computation local for now, but reads input from and
     * publishes results to the private S3 bucket.
     */
    aws_s3 {
        docker.enabled = true

        params {
            input = 's3://lartieda-nextflow-portfolio-2026/input/expression.csv'
            outdir = 's3://lartieda-nextflow-portfolio-2026/results'
        }

        aws {
            region = 'us-east-1'

            client {
                storageEncryption = 'AES256'
            }
        }
    }
}
