nextflow.enable.dsl = 2

plugins {
    id 'nf-amazon'
}

docker.enabled = true

params {
    input = 'data/expression.csv'
    outdir = 'results'
    preprocess_script = 'scripts/preprocess.py'
    analyze_script = 'scripts/analyze.py'
    container_image = 'bioinformatics-pipeline:latest'
}

profiles {
    local {
        docker.enabled = true
    }

    aws_batch {
        process {
            executor = 'awsbatch'
            queue = 'nextflow-portfolio-queue'
            cpus = 1
            memory = '2 GB'
        }

        workDir = 's3://lartieda-nextflow-portfolio-2026/work'

        params {
            input = 's3://lartieda-nextflow-portfolio-2026/input/expression.csv'
            outdir = 's3://lartieda-nextflow-portfolio-2026/results/batch'
            container_image = '352285845344.dkr.ecr.us-east-1.amazonaws.com/nextflow-portfolio-pipeline:v1.0.1'
        }

        aws {
            region = 'us-east-1'

            batch {
                platformType = 'fargate'
                jobRole = 'arn:aws:iam::352285845344:role/NextflowPortfolioBatchTaskRole'
                executionRole = 'arn:aws:iam::352285845344:role/NextflowPortfolioBatchExecutionRole'
            }
        }

        wave {
            enabled = true
        }
    }

    aws_s3 {
        docker.enabled = true

        params {
            input = 's3://lartieda-nextflow-portfolio-2026/input/expression.csv'
            outdir = 's3://lartieda-nextflow-portfolio-2026/results'
        }

        aws {
            region = 'us-east-1'

            client {
                storageEncryption = 'AES256'
            }
        }
    }
}
